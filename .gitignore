# Ignore environment configuration files containing sensitive credentials
.env
.tokens.json

# Ignore Python compiled files and bytecode
__pycache__/
*.py[cod]
*$py.class

# Ignore test logs and output JSON files
*.log
deepseek_chat_history.json
deepseek_response.json

# Ignore IDE and test cache
.vscode/
.idea/
.pytest_cache/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
